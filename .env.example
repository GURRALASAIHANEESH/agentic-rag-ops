# ─────────────────────────────────────────────────────────────
# RAG Ops — Root Environment (used by docker-compose)
# Copy to .env at repo root and fill in values.
# ─────────────────────────────────────────────────────────────

# ── Postgres (Docker) ────────────────────────────────────────
POSTGRES_USER=ragops
POSTGRES_PASSWORD=ragops_pass
POSTGRES_DB=ragops_db
POSTGRES_PORT=5432

# ── Backend ──────────────────────────────────────────────────
BACKEND_PORT=8000

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_PASSWORD=admin

# ── Prometheus ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
