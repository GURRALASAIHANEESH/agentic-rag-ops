# ─────────────────────────────────────────────────────────────
# Frontend environment variables
# Copy to .env.local and fill in values for local development.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Backend API URL — used server-side in Next.js for SSR/rewrites.
# In production this is your internal service URL (e.g. http://api:8000).
# In development this points to your locally running FastAPI server.
INTERNAL_API_URL=http://localhost:8000

# Public API URL — used browser-side when INTERNAL_API_URL is not available.
# Next.js rewrites proxy /api/* so this is only needed as a fallback.
NEXT_PUBLIC_API_URL=http://localhost:8000

# App metadata
NEXT_PUBLIC_APP_NAME="RAG Ops"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Optional: Disable critic agent in the UI by default
NEXT_PUBLIC_CRITIC_DEFAULT_ENABLED=true

# Optional: Default LLM provider shown in QueryConsole
# Values: local | groq | openai
NEXT_PUBLIC_DEFAULT_PROVIDER=local
