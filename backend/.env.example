# ─────────────────────────────────────────────────────────────
# Agentic RAG Ops — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_NAME="Agentic RAG Ops"
ENVIRONMENT=development
DEBUG=true

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── Database ─────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://ragops:ragops_pass@localhost:5433/ragops_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Provider ─────────────────────────────────────────────
# Options: local | openai | groq
# Use "local" for zero-cost demo (requires llama.cpp server running)
LLM_PROVIDER=local

# Local llama.cpp (start with: cd llm && bash run_server.sh)
LLAMA_SERVER_URL=http://localhost:8080
LLAMA_MODEL_NAME=llama-3.2-3b-q4
LLAMA_MAX_TOKENS=1024
LLAMA_TEMPERATURE=0.1

# OpenAI (leave blank if LLM_PROVIDER=local)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq free tier (leave blank if LLM_PROVIDER=local)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Embeddings ───────────────────────────────────────────────
# all-MiniLM-L6-v2 is free, ~80MB, CPU-only, 384-dim
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# ── Vector Store ─────────────────────────────────────────────
# Options: pgvector | faiss
# pgvector = persistent (recommended), faiss = in-memory fallback
VECTOR_STORE_BACKEND=pgvector
FAISS_INDEX_PATH=./faiss_index

# ── File Storage ─────────────────────────────────────────────
# Options: local | supabase
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_MIME_TYPES=application/pdf,text/plain

# Supabase (only if STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=rag-documents

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.3

# ── Critic ───────────────────────────────────────────────────
CRITIC_CONFIDENCE_THRESHOLD=0.6
CRITIC_ENABLED=true

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── Retention ────────────────────────────────────────────────
DOCUMENT_RETENTION_DAYS=30

# ── Observability ────────────────────────────────────────────
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
